# Copy to .env and fill in. Never commit .env.
# Meta Ad Library API (free): https://www.facebook.com/ads/library/api
META_ACCESS_TOKEN=
# Google BigQuery public dataset (free sandbox works)
GOOGLE_CLOUD_PROJECT=
# GOOGLE_MAX_BYTES_BILLED=10737418240
# CACHE_TTL_SECONDS=3600
# Local LLM for reading captured pages (optional, free, offline): https://ollama.com
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3        # use llama3.2:3b on machines with < 8 GB free RAM
